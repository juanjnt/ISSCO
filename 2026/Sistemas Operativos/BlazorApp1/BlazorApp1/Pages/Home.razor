    .code-editor pre {
        background-color: transparent;
        padding: 15px;
        border-radius: 4px;
        margin: 0;
        font-family: 'Consolas', monospace;
        color: #33ff33;
        font-size: 0.95rem;
        line-height: 1.5;
        position: relative;
        z-index: 12;
        text-shadow: 0 0 4px rgba(51,255,51,0.4);
    }

    .keyword {
        color: #66b2ff;
        font-weight: bold;
    }

    .code-line {
        padding-left: 15px;
        color: #33ff33;
        transition: background-color 0.2s;
    }

    .active-line {
