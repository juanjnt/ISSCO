    .rainbow-bg {
        background: linear-gradient( to bottom right, rgba(255, 0, 0, 0.08), rgba(255, 165, 0, 0.08), rgba(255, 255, 0, 0.08), rgba(0, 128, 0, 0.08), rgba(0, 0, 255, 0.08), rgba(75, 0, 130, 0.08), rgba(238, 130, 238, 0.08) );
    }

    .console-bg {
        background-color: #2b2b2b;
        background-image: linear-gradient(rgba(0, 0, 0, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.1) 1px, transparent 1px);
        background-size: 12px 12px;
    }

    .matrix-bg {
        background-color: #000;
        border-color: #004400;
    }

    .code-editor {
        position: relative;
        min-height: 250px;
    }

    .matrix-effect {
        position: absolute;
