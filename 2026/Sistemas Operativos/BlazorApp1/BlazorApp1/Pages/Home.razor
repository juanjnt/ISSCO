@page "/"
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime

<div class="game-container">

    <div class="crt-screen-bg">
        <div class="crt-flicker"></div>
        <div class="crt-scanlines"></div>
    </div>

    <header class="game-header">
        <h1>GeoCode</h1>
    </header>
    <div class="stats-bar">
        <div class="stat-box">
            <span class="stat-label">🏆 Victorias Totales:</span>
            <span class="stat-value text-success">@VictoriasTotales</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">🗺️ Mapas Jugados:</span>
            <span class="stat-value text-info">@ContadorMapas</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">🎯 Intentos en este Mapa:</span>
            <span class="stat-value text-warning">@IntentosMapaActual</span>
        </div>
    </div>

    <div class="game-layout">
        <section class="panel board-panel rainbow-bg">
            <h2>GeoCode - Nivel Activo</h2>
            <div class="grid-board">
                @for (int r = 0; r < Filas; r++)
                {
                    <div class="grid-row">
                        @for (int c = 0; c < Columnas; c++)
                        {
                            int filaActual = r;
                            int colActual = c;
                            string claseCelda = ObtenerClaseCelda(filaActual, colActual);

                            <div class="grid-cell @claseCelda" style="position: relative;">
                                @if (RobotFila == filaActual && RobotColumna == colActual)
                                {
                                    <span class="robot" style="transform: rotate(@(ObtenerRotacionRobot())deg); display: inline-block;">🤖</span>
                                }
                                else if (MatrizLaberinto[filaActual, colActual] == 1)
                                {
                                    <span class="obstaculo-icono">❌</span>
                                }
                                else if (MatrizLaberinto[filaActual, colActual] == 2)
                                {
                                    <span class="meta">🟩</span>
                                }

                                @if (filaActual == RobotFilaInicio && colActual == RobotColumnaInicio && !EstaEjecutando && IndiceLineaActiva == -1 && RobotFila == RobotFilaInicio && RobotColumna == RobotColumnaInicio)
                                {
                                    <div class="tooltip-inicio">¡Inicias acá!</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="panel control-panel console-bg">
            <h2>Comandos</h2>

            <div class="d-pad-container">
                <div class="d-pad">
                    <div></div>
                    <button class="btn btn-arcade" @onclick="ComandoNorte" disabled="@EstaEjecutando">⬆️</button>
                    <div></div>

                    <button class="btn btn-arcade" @onclick="ComandoOeste" disabled="@EstaEjecutando">⬅️</button>
                    <div class="d-pad-center"></div>
                    <button class="btn btn-arcade" @onclick="ComandoEste" disabled="@EstaEjecutando">➡️</button>

                    <div></div>
                    <button class="btn btn-arcade" @onclick="ComandoSur" disabled="@EstaEjecutando">⬇️</button>
                    <div></div>
                </div>
            </div>

            <div class="actions-section">
                <button class="btn btn-success" @onclick="EjecutarSecuencia" disabled="@(EstaEjecutando || ColaComandos.Count == 0)">
                    ▶️ Ejecutar Código
                </button>
                <button class="btn btn-warning" @onclick="ReiniciarSoloRobot" disabled="@EstaEjecutando">
                    ↩️ Reiniciar Robot
                </button>
                <button class="btn btn-secondary" @onclick="CambiarMapaCompleto" disabled="@EstaEjecutando">
                    🔄 Nuevo Mapa
                </button>
            </div>

            @if (!string.IsNullOrEmpty(MensajeEstado))
            {
                <div class="alert @ClaseMensaje">
                    @MensajeEstado
                </div>
            }
        </section>

        <section class="panel code-panel matrix-bg">
            <h2>Consola de Código (C# Simulado)</h2>
            <div class="code-editor">
                <div class="matrix-effect"></div>
                <pre><code><span class="keyword">inicio;</span>
@if (ColaComandos != null)
{
        @for (int i = 0; i < ColaComandos.Count; i++)
        {
                int indexActual = i;
                        <div class="code-line @(IndiceLineaActiva == indexActual ? "active-line" : "")">robot.@(ColaComandos[indexActual])();</div>
        }
}
<span class="keyword">fin;</span></code></pre>
            </div>
        </section>
    </div>
</div>

<style>
    .game-container {
